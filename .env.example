# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/chat.log
# JSON array of exact browser origins. Required in production; wildcard is rejected.
CORS_ORIGINS=["http://localhost:3000"]

# Database (required)
DATABASE_URL=mysql+pymysql://dental_ai:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/dental_agent_db

# Authentication (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Engines: openai or local
EMBEDDING_ENGINE=openai
LLM_ENGINE=openai

# OpenAI: required when either selected engine is openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Local LLM through the OpenAI-compatible Ollama API
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# Shared provider transport settings
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2

# Local embedding
LOCAL_EMBEDDING_MODEL=keepitreal/vietnamese-sbert
LOCAL_EMBEDDING_DIM=768

# Retrieval
MULTI_QUERY_EXPANSION=true
TOP_K=10
VECTOR_DB_DIR=data/vector_db

# Data paths
RAW_DATA_PATH=data/raw/dental_dataset.json
RAW_DATA_V2_PATH=data/raw/dental_dataset_v2.json
PROCESSED_DATA_PATH=data/processed/chunks.json

# Offline tools
UPGRADE_DATASET_MODEL=gpt-4o-mini
AUTO_PIPELINE_MODEL=gpt-4.1-mini
